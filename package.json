{
  "name": "animelist",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "clean-ios": "sh scripts/clean_ios.sh",
    "clean-android": "sh scripts/clean_android.sh",
    "reset-npm": "sh scripts/reset_npm.sh",
    "reset-ios": "npm run reset-npm && npm run clean-ios",
    "reset-android": "npm run reset-npm && npm run clean-android",
    "reset-all": "npm run reset-npm && npm run clean-ios && npm run clean-android",
    "start": "npx expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "^8.13.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.101.4",
    "dayjs": "^1.11.21",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "^3.0.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.83.1",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
